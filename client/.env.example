# ==============================================================================
# SkillBridge AI — Client Environment Variables (TEMPLATE)
# ------------------------------------------------------------------------------
# Copy this file to `.env` in the same folder.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_ to the browser.
# NEVER put secrets here — anything VITE_ prefixed is PUBLIC and shipped to
# the client bundle. API keys, JWT secrets and DB URIs belong in server/.env.
# ==============================================================================

# Base URL of the backend API, including the version prefix.
VITE_API_URL=http://localhost:5000/api/v1

# Display name used in the UI.
VITE_APP_NAME=SkillBridge AI
