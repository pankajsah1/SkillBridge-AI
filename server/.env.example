# ==============================================================================
# SkillBridge AI — Server Environment Variables (TEMPLATE)
# ------------------------------------------------------------------------------
# Copy this file to `.env` in the same folder, then fill in real values.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# NEVER commit `.env`. It is already listed in .gitignore.
# ==============================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=5000

# ---- API ----
# All routes are mounted under this prefix.
API_PREFIX=/api/v1

# ---- CORS ----
# The Vite dev server origin. Must match where the client actually runs.
CLIENT_URL=http://localhost:5173

# ---- MongoDB ----
# Option A — Local MongoDB (works with MongoDB Compass / local mongod):
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge_ai
#
# Option B — MongoDB Atlas (free tier). Replace the placeholders, keep the db name:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillbridge_ai?retryWrites=true&w=majority
#
# NOTE: if your password contains @ : / ? # [ ] or %, URL-encode it.

# ------------------------------------------------------------------ Auth (Step 2)
# Generate your own secret — never reuse this placeholder and never commit a real one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
# Accepts ms-style durations: 15m, 12h, 7d
JWT_EXPIRES_IN=7d

# --------------------------------------------- Optional AI layer (assessments)
# LEAVE ALL THREE BLANK AND EVERYTHING STILL WORKS. The assessment engine has a
# deterministic question bank (server/src/data/questionBank.seed.js) and falls
# back to it on a missing key, a timeout, an exhausted quota or a malformed
# reply. No AI variable is ever required to run, seed, test or demo this app.
#
# Fill all three in to have questions generated instead. Partially filled counts
# as unconfigured, because a URL with no key just fails on every request.
#
# The AI only writes question and option TEXT. It never calculates a score:
# skill scores, readiness and match percentages are arithmetic on the server.
#
# Two request shapes are supported, detected from the URL:
#   OpenAI-compatible chat completions (OpenAI, Groq, OpenRouter, Together,
#   Mistral, DeepSeek, Ollama, LM Studio) — the default. Examples:
#     AI_API_URL=https://api.openai.com/v1/chat/completions
#     AI_API_URL=https://api.groq.com/openai/v1/chat/completions
#     AI_API_URL=http://127.0.0.1:11434/v1/chat/completions
#   Google Gemini generateContent — used when the URL contains
#   generativelanguage.googleapis.com:
#     AI_API_URL=https://generativelanguage.googleapis.com/v1beta
#
# NEVER put a real key in this file. It is committed. Put it in .env only.
AI_API_KEY=
AI_API_URL=
AI_MODEL=
# How long to wait for the provider before falling back. Default 12000.
AI_TIMEOUT_MS=12000

# Shared password for every account created by `npm run seed:demo`.
# Demo data only. Existing accounts keep whatever password they already had.
DEMO_PASSWORD=Demo1234
