# ==============================================================================
# SkillBridge AI — Server Environment Variables (TEMPLATE)
# ------------------------------------------------------------------------------
# Copy this file to `.env` in the same folder, then fill in real values.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# NEVER commit `.env`. It is already listed in .gitignore.
# ==============================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=5000

# ---- API ----
# All routes are mounted under this prefix.
API_PREFIX=/api/v1

# ---- CORS ----
# The Vite dev server origin. Must match where the client actually runs.
CLIENT_URL=http://localhost:5173

# ---- MongoDB ----
# Option A — Local MongoDB (works with MongoDB Compass / local mongod):
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge_ai
#
# Option B — MongoDB Atlas (free tier). Replace the placeholders, keep the db name:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillbridge_ai?retryWrites=true&w=majority
#
# NOTE: if your password contains @ : / ? # [ ] or %, URL-encode it.
